# Database driver: pglite (embedded, on disk — default), pglite-memory (embedded, in memory, seeded on boot — sandbox deploys) or neon (Postgres over HTTP)
DB_DRIVER=pglite
# For pglite: directory for the file-backed database
PGLITE_DIR=.pglite
# Seed the database on boot when it is empty (true for sandbox deploys)
DB_SEED_ON_BOOT=true
# For neon:
DATABASE_URL=
# Session signing secret (32+ random chars). Required in production; a dev-only default is used otherwise.
AUTH_SECRET=
# Optional passcode gate for public hosting; leave empty to disable
SITE_PASSCODE=
